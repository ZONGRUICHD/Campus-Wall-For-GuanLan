{
  "name": "campuswall-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm --workspace backend run dev\" \"npm --workspace frontend run dev\"",
    "dev:local": "npm run db:up && npm run db:wait && npm run dev",
    "build": "npm --workspace frontend run build",
    "check": "npm --workspace backend run check && npm --workspace frontend run build",
    "test": "npm --workspace backend test && npm --workspace frontend test && npm run test:contracts",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:e2e:http": "npm --workspace frontend run test:e2e",
    "start:backend": "npm --workspace backend start",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "clean": "node scripts/clean.mjs",
    "admin:reset-password": "npm --workspace backend run admin:reset-password --",
    "db:up": "docker compose -f compose.yml up -d postgres",
    "db:down": "docker compose -f compose.yml down",
    "db:wait": "npm --workspace backend run db:wait",
    "db:migrate": "npm --workspace backend run migrate:postgres"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
