{
  "name": "campuswall-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm --workspace backend run dev\" \"npm --workspace frontend run dev\"",
    "dev:local": "npm run db:up && npm run db:wait && npm run dev",
    "build": "npm --workspace frontend run build",
    "test:backend": "npm --workspace backend test",
    "start:backend": "npm --workspace backend start",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "admin:reset-password": "npm --workspace backend run admin:reset-password --",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:wait": "npm --workspace backend run db:wait",
    "db:migrate": "npm --workspace backend run migrate:sqlite"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
