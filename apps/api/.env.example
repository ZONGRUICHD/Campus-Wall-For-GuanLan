# Local development defaults are safe without this file. Production must set
# every value below in Vercel and GitHub Actions secrets.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
CORS_ORIGINS=https://your-org.github.io
JWT_SECRET=replace-with-at-least-32-random-characters
PII_HASH_SECRET=replace-with-a-different-32-character-random-value
CRON_SECRET=replace-with-another-32-character-random-value

# Used only by `campus-wall-api bootstrap-admin`. Store the requested initial
# credential as a deployment secret; never commit its value.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-initial-password

# Optional post-image uploads. Production keeps uploads disabled until all
# values are configured and the bucket CORS policy allows the Web origin.
MEDIA_UPLOADS_ENABLED=false
MEDIA_UPLOAD_MAX_BYTES=8388608
MEDIA_MAX_IMAGE_PIXELS=24000000
MEDIA_MAX_PER_POST=6
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_UPLOADS_PER_MINUTE=20
OBJECT_STORAGE_ENDPOINT=https://your-s3-compatible-endpoint
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=campus-wall-media
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.wall.example.edu
OBJECT_STORAGE_FORCE_PATH_STYLE=false
