# Local development defaults are safe without this file. Production must set
# every value below in Vercel and GitHub Actions secrets.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
CORS_ORIGINS=https://your-org.github.io
JWT_SECRET=replace-with-at-least-32-random-characters
PII_HASH_SECRET=replace-with-a-different-32-character-random-value

# Used only by `campus-wall-api bootstrap-admin`. Store the requested initial
# credential as a deployment secret; never commit its value.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-initial-password
