# Copy this file to .env and replace every "replace-with-..." value.
# Never commit the populated .env file.
COMPOSE_PROJECT_NAME=campus-wall

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
APP_ORIGIN=http://localhost:8080

POSTGRES_DB=campus_wall
POSTGRES_USER=campus_wall
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-at-least-32-random-bytes

# Set both values as shown below when APP_ORIGIN uses HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_MAX_AGE=604800

MAX_BODY_SIZE=1048576
MAX_CONTENT_LENGTH=524288000
MAX_CHUNK_SIZE=10485760
MAX_CHUNK_COUNT=100
UPLOAD_BINDING_TTL_MS=1800000
CHUNK_UPLOAD_TTL_MS=86400000
UPLOAD_CLEANUP_INTERVAL_MS=300000
FFMPEG_TIMEOUT_MS=120000
MAX_TEXT_LENGTH=10000
MAX_TITLE_LENGTH=200
MAX_EMAIL_LENGTH=320
MAX_TAGS=10
MAX_TAG_LENGTH=50
MAX_MESSAGE_FILES=20
MAX_COMMENT_FILES=10
MAX_POLL_OPTIONS=6
MAX_POLL_QUESTION_LENGTH=200
MAX_POLL_OPTION_LENGTH=80
MAX_POLL_DURATION_DAYS=30
MAX_AVATAR_SIZE=5242880
MAX_APP_ICON_SIZE=5242880
MAX_USER_IMPORT_SIZE=10485760
MAX_USER_IMPORT_ROWS=5000
MESSAGE_PAGE_SIZE=15
MAX_PUBLIC_QUERY_SIZE=10000
RATE_LIMIT_LOGIN=30
RATE_LIMIT_WRITE=40
RATE_LIMIT_INTERACTION=240
RATE_LIMIT_UPLOAD=600
RATE_LIMIT_FEEDBACK=20

CAPTCHA_PROVIDER=none
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_TIMEOUT_MS=8000

# Frontend build-time values. Leave URL values empty for the same-origin deployment.
VITE_API_BASE_URL=
VITE_STATIC_URL=
VITE_UMAMI_WEBSITE_ID=dd522469-2b45-4814-812e-202678ccee7a

# Registry pointers for deployment; each built artifact is identified by its OCI digest.
BACKEND_IMAGE=campus-wall-backend:local
FRONTEND_IMAGE=campus-wall-frontend:local
