SCHOOL_NAME=龙华区观澜中学
SITE_NAME=龙华区观澜中学校园墙
# First verified public HTTP 200 response. Keep this timestamp unchanged across deployments.
SITE_LAUNCHED_AT=2026-08-25T01:48:50+08:00
APP_NAME=龙华区观澜中学校园墙 API
NODE_ENV=development
DEBUG=false
SECRET_KEY=change-this-secret-in-production

HOST=127.0.0.1
PORT=5412

# Prefer DATABASE_URL when you want a single PostgreSQL connection string.
# Leave DATABASE_URL empty to use the PG* settings below.
# PG* defaults are for local development; use your real production values in deployment.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=campus_wall
PGUSER=campus_wall
PGPASSWORD=campus_wall_dev
PGSSL=false
# Used only when PGSSL=true. Production-like NODE_ENV defaults to verifying the certificate.
PGSSL_REJECT_UNAUTHORIZED=true

# Old SQLite source used only by npm run db:migrate.
SQLITE_MESSAGE_DB_PATH=static/messages/messages.db

UPLOAD_FOLDER=static/uploads
CHUNK_FOLDER=static/chunks
TINY_FOLDER=static/tiny_files
AVATAR_FOLDER=static/avatars
MAX_BODY_SIZE=1048576
MAX_CONTENT_LENGTH=104857600
MAX_CHUNK_SIZE=10485760
UNREFERENCED_UPLOAD_RETENTION_MS=7200000
PENDING_ATTACHMENT_RETENTION_MS=172800000
MAX_UPLOAD_STORAGE_BYTES=8589934592
MIN_FREE_DISK_BYTES=8589934592
FFMPEG_TIMEOUT_MS=120000
MAX_TEXT_LENGTH=10000
MAX_TITLE_LENGTH=200
MAX_EMAIL_LENGTH=320
MAX_TAGS=10
MAX_TAG_LENGTH=50
MAX_MESSAGE_FILES=20
MAX_COMMENT_FILES=10
POST_IMAGE_MAX_EDGE=2048
POST_IMAGE_WEBP_QUALITY=80
POST_IMAGE_MAX_OUTPUT_BYTES=1572864
MAX_POST_IMAGE_INPUT_PIXELS=50000000
MAX_POLL_OPTIONS=6
MAX_POLL_QUESTION_LENGTH=200
MAX_POLL_OPTION_LENGTH=80
MAX_POLL_DURATION_DAYS=30
MAX_AVATAR_SIZE=5242880
AVATAR_OUTPUT_SIZE=512
AVATAR_WEBP_QUALITY=82
MAX_AVATAR_INPUT_PIXELS=40000000
MAX_CONCURRENT_AVATAR_PROCESSING=2
MESSAGE_PAGE_SIZE=15
MAX_PUBLIC_QUERY_SIZE=10000
RATE_LIMIT_LOGIN=30
RATE_LIMIT_REGISTER=10
RATE_LIMIT_WRITE=40
RATE_LIMIT_INTERACTION=240
RATE_LIMIT_UPLOAD=240
RATE_LIMIT_UPLOAD_BYTES=268435456
MAX_CONCURRENT_UPLOADS_PER_IP=3
MAX_CONCURRENT_UPLOADS_GLOBAL=24
RATE_LIMIT_FEEDBACK=20
RATE_LIMIT_NOTIFICATION_TEST=5
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_EMAIL=8
MAX_FEEDBACK_RECORDS=5000
MAX_REPORT_RECORDS=5000
CAPTCHA_PROVIDER=none
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_TIMEOUT_MS=8000

SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE=604800
PUBLIC_SITE_URL=https://wall.zongtech.xyz
PUBLIC_API_URL=https://api-wall.zongtech.xyz

# Feishu OAuth login for ordinary users. Keep App Secret and chat_id only in the
# server environment file; never commit them, put them in HANDOFF, or expose
# them through VITE_*. Production callback registered in the Feishu console:
# https://api-wall.zongtech.xyz/api/user/feishu/callback
# This is a separate web app from the moderation custom-bot Webhook.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_LOGIN_CHAT_ID=
FEISHU_REDIRECT_URI=
FEISHU_TIMEOUT_MS=8000

# Optional SMTP for account verification/notification mail and the admin
# moderation email channel. Keep the password only in the server environment.
PUBLIC_API_URL=https://api-wall.zongtech.xyz
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=20000

# Separate key for encrypting notification Webhooks and signing secrets saved
# from the admin console. Generate a long random value in production. When it
# is empty, SECRET_KEY is used for backwards-compatible local development.
NOTIFICATION_MASTER_KEY=

# Moderation group-bot notifications. Keep complete webhook URLs and signing
# secrets only in the server environment; never expose them to the frontend.
# One or both providers can be configured. New posts, edited posts and posts
# returned to review are written to a durable PostgreSQL outbox before commit.
MODERATION_NOTIFY_ENABLED=false
MODERATION_NOTIFY_FEISHU_WEBHOOK=
MODERATION_NOTIFY_FEISHU_SECRET=
MODERATION_NOTIFY_WECOM_WEBHOOK=
MODERATION_NOTIFY_EMAIL_TO=
MODERATION_NOTIFY_TIMEOUT_MS=5000
MODERATION_NOTIFY_MAX_ATTEMPTS=6
MODERATION_NOTIFY_POLL_MS=2000
MODERATION_NOTIFY_COALESCE_MS=5000
MODERATION_NOTIFY_MIN_INTERVAL_MS=30000
MODERATION_NOTIFY_BATCH_SIZE=50
MODERATION_NOTIFY_RETENTION_DAYS=30

# Comma-separated list. Defaults are used when empty.
ALLOWED_ORIGINS=https://wall.zongtech.xyz
